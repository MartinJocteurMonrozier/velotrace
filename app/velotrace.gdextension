[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
reloadable = true

[libraries]

linux.debug.x86_64 = "res://../target/debug/libvelo_godot.so"
linux.release.x86_64 = "res://../target/release/libvelo_godot.so"
windows.debug.x86_64 = "res://../target/debug/velo_godot.dll"
windows.release.x86_64 = "res://../target/release/velo_godot.dll"
